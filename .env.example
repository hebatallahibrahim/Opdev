# Copy to .env.local and fill in.

# Form submissions are emailed through Resend (https://resend.com).
# 1. Create a Resend account and verify the opdev.ai domain (DNS records).
# 2. Create an API key and paste it here.
RESEND_API_KEY=

# Where leads are delivered (comma-separate for several inboxes).
INQUIRY_TO=info@opdev.ai

# Sender — must be on the verified domain.
INQUIRY_FROM=OP Dev. Website <website@opdev.ai>

# Optional: consultation booking link (Cal.com / Calendly) shown on /contact.
NEXT_PUBLIC_BOOKING_URL=
